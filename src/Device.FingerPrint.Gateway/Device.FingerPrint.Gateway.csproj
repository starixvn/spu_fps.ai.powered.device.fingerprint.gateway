<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>b7faf95e-21e4-4bb1-8113-ef37a20f453e</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerfileContext>..\..</DockerfileContext>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Fanex.Logging.Extensions" Version="2.0.2.1" />
    <PackageReference Include="Fanex.Logging.Extensions.AspNetCore" Version="1.1.0" />
    <PackageReference Include="Fanex.Logging.Sentry" Version="5.0.0.1" />
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.22.1" />
    <PackageReference Include="Ocelot" Version="24.0.1" />
    <PackageReference Include="prometheus-net" Version="8.2.1" />
    <PackageReference Include="prometheus-net.AspNetCore" Version="8.2.1" />
    <PackageReference Include="StackExchange.Redis.Extensions.Core" Version="11.0.0" />
    <PackageReference Include="StackExchange.Redis.Extensions.MsgPack" Version="11.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="9.0.4" />
	<SonarQubeSetting Include="sonar.coverage.exclusions">
		<Value>**/Program.cs</Value>
	</SonarQubeSetting>
  </ItemGroup>

</Project>
